                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}/stop": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Stop Run",
        "description": "Stop after the calls in flight. The chunk in progress is redone on resume, for free.",
        "operationId": "stopRun",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
