  "components": {
    "schemas": {
      "Body_createDataset": {
        "properties": {
          "file": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "File",
            "description": "File to upload."
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source",
            "description": "Path of a file on the server, or a public http(s) URL."
          }
        },
        "type": "object",
        "title": "Body_createDataset"
      },
      "Column": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "title": "Column"
      },
      "ColumnProfile": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "min": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min"
          },
          "max": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max"
          },
          "avg": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg"
          },
          "approx_unique": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approx Unique"
          },
          "null_percentage": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Null Percentage"
          }
        },
        "type": "object",
        "required": [
          "name",
          "type",
          "min",
          "max",
          "avg",
          "approx_unique",
          "null_percentage"
        ],
        "title": "ColumnProfile"
      },
      "Dataset": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "row_count": {
            "type": "integer",
            "title": "Row Count"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "columns": {
            "items": {
              "$ref": "#/components/schemas/Column"
            },
            "type": "array",
            "title": "Columns"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id",
            "description": "The dataset it was made from by a run."
          },
          "run": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DatasetRun"
              },
              {
                "type": "null"
              }
            ],
            "description": "The run that makes it; its rows fill in as it goes."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "source",
          "row_count",
          "size_bytes",
          "columns",
          "created_at",
          "parent_id",
          "run"
        ],
        "title": "Dataset"
      },
      "DatasetRun": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "number": {
            "type": "integer",
            "title": "Number",
            "description": "1, 2, \u2026 per parent dataset."
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "stopping",
              "stopped",
              "done",
              "failed"
            ],
            "title": "Status"
          },
          "done": {
            "type": "integer",
            "title": "Done",
            "description": "Model calls answered so far."
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Model calls the run makes."
          }
        },
        "type": "object",
        "required": [
          "id",
          "number",
          "status",
          "done",
          "total"
        ],
        "title": "DatasetRun",
        "description": "The run that makes a dataset."
      },
      "Filter": {
        "properties": {
          "column": {
            "type": "string",
            "title": "Column"
          },
          "op": {
            "type": "string",
            "enum": [
              "eq",
              "ne",
              "lt",
              "lte",
              "gt",
              "gte",
              "contains",
              "is_null",
              "is_not_null"
            ],
            "title": "Op"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "column",
          "op"
        ],
        "title": "Filter"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "Health"
      },
      "Job": {
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/Task-Output"
            },
            "type": "array",
            "title": "Tasks"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "scope",
          "tasks",
          "id",
          "dataset_id",
          "created_at",
          "updated_at"
        ],
        "title": "Job"
      },
